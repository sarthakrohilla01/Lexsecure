# LexSecure backend configuration — copy to `backend/.env` and edit.
# NEVER commit real values. In production, source these from a KMS/secret manager.
# config.py REFUSES to start with ENVIRONMENT=production while
# JWT_SECRET_KEY / DOCUMENT_ENCRYPTION_KEY still hold prototype defaults.

# development | production
ENVIRONMENT=development

# Long, random, unique values (64+ chars for JWT; exactly 64 hex chars = 32 bytes for the AES key)
JWT_SECRET_KEY=change-me-to-a-long-random-string
DOCUMENT_ENCRYPTION_KEY=change-me-64-hex-chars-for-aes-256-key

# --- Database --------------------------------------------------------------
# Production: PostgreSQL (docker-compose starts one and sets this).
# Local development without Docker: SQLite (default, zero setup).
# DATABASE_URL=postgresql+psycopg://lexsecure:change-me@localhost:5432/lexsecure
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE_SECONDS=1800

# Optional overrides
# STORAGE_TYPE=vault            # vault | minio
# LOCAL_STORAGE_VAULT_DIR=../storage/vault

# --- Multi-factor authentication (TOTP, RFC 6238) --------------------------
# Every account uses a real authenticator app. Enrol accounts with:
#   python backend/scripts/provision_mfa.py
# There is NO universal bypass code.
# MFA_ISSUER=LexSecure NCRB
# MFA_TOTP_WINDOW=1
# MFA_BACKUP_CODE_COUNT=10

# --- Continuous integrity monitoring --------------------------------------
# Background verification of every document against its hash + signature + ledger anchor.
# 0 disables the scheduler.
# INTEGRITY_CHECK_INTERVAL_SECONDS=300

# --- Real LLM provider -----------------------------------------------------
# nara (NaraRouter, OpenAI-compatible) | gemini | ollama | openai
# LLM_PROVIDER=nara

# NaraRouter (https://router.bynara.id) — one key for Claude/GPT/Gemini/DeepSeek...
# Onboarding: issue a key (sk-nry-...), bind Telegram, join the required
# Telegram group/channel and relink at https://router.bynara.id/settings
# NARA_API_KEY=sk-nry-xxxxxxxx
# NARA_BASE_URL=https://router.bynara.id/v1
# Free-tier models (comma separated failover list) — see https://router.bynara.id/ai-models
# Verified latency: minimax ~8s, agnes ~13s; laguna/nemotron returned 502 upstream.
# NARA_MODELS=agnes-2.5-flash
# Shorter answers are faster and cheaper on the free tier
# LLM_MAX_OUTPUT_TOKENS=800
# Optional embedding model id (catalog is chat/image only — leave empty to use local vectors)
# NARA_EMBEDDING_MODEL=

# Google Gemini (https://aistudio.google.com/apikey)
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.8-flash
# GEMINI_API_KEY=your_key_here
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash

# Local Ollama (fully offline)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# LLM_BASE_URL=http://localhost:11434
# LLM_API_KEY=
# LLM_TIMEOUT_SECONDS=45

# Semantic search embeddings: local (offline) | gemini | nara
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=gemini-embedding-001
